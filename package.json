{
  "name": "setup-ibmmq-action",
  "version": "1.0.0",
  "description": "Set up and teardown an IBM MQ broker for GitHub Actions workflows.",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "dev": "npm-watch",
    "prepare": "ncc build index.mjs -o dist --license licenses.txt"
  },
  "watch": {
    "prepare": {
      "patterns": [
        "index.mjs"
      ],
      "ignore": "dist/*",
      "runOnChangeOnly": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particular/setup-ibmmq-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1",
    "dotenv": "^17.0.0",
    "npm-watch": "^0.13.0"
  }
}